# ── Datasets & derived data (not tracked — see README) ──────
# Raw corpora (DARPA TC E3 THEIA, OpTC, Splunk BOTSv2) live outside the repo.
external/
darpa_data/
datasets/
splunk-botsv2_data/

# Regenerable ML intermediates. Trained weights under trained_weights/ and
# botsv2/models/ ARE tracked; these caches are rebuilt by the prepare/featurize
# scripts on first run.
*.parquet
server/ml-engine/optc/_cache_*.pkl
server/ml-engine/optc/_deblob_*.pkl
server/ml-engine/optc/_feat_*.npz
server/ml-engine/experiments/

# Superseded training runs (not wired into the stack)
server/ml-engine/theia/trained_weights/_orthrus_smoke/
server/ml-engine/theia/trained_weights/orthrus_theia_e3/

# Experiment stdout captured as provenance — cited by name in docs/provenance/.
!server/ml-engine/theia/*.log
!server/ml-engine/theia/*.out
!server/ml-engine/optc/*.log
!server/ml-engine/optc/*.out
