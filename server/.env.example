# Copy to server/.env before `docker compose up -d`.
# Every key is optional — the stack starts without them, LLM features stay off.

# ── LLM providers (api + llm-analyzer) ──────────────────────
# Gemini drives the incident narratives; the rest are optional second opinions.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Wazuh export (optional) ─────────────────────────────────
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASS=
