# =============================================================================
# Ophanim EDR Configuration
# Copy this to .env and customize for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Agent Settings
# -----------------------------------------------------------------------------
# Unique identifier for this endpoint (auto-detected if not set)
EDR_ENDPOINT_ID=

# Server URL for event exfiltration
SERVER_URL=http://localhost:8000

# API key for authentication (optional)
AGENT_API_KEY=

# Verbose terminal output (true = show full event details, false = summary only)
VERBOSE_OUTPUT=false

# -----------------------------------------------------------------------------
# Collection Settings
# -----------------------------------------------------------------------------
# Seconds between process snapshots
PROCESS_POLL_INTERVAL=2.0

# Enable/disable collectors
SYSMON_ENABLED=true
FILESYSTEM_ENABLED=true
NETWORK_ENABLED=true

# Paths to monitor for filesystem changes (comma-separated)
FILE_WATCH_PATHS=

# -----------------------------------------------------------------------------
# Logging Settings
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Local JSON log directory (default: %APPDATA%/Ophanim/logs/)
LOG_DIR=

# Max log file size before rotation (MB)
LOG_MAX_SIZE_MB=10

# Number of backup log files to keep
LOG_BACKUP_COUNT=10

# Enable/disable local JSON logging
LOCAL_LOGGING_ENABLED=true

# -----------------------------------------------------------------------------
# Server Settings (for docker-compose)
# -----------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ophanim_edr

# -----------------------------------------------------------------------------
# Detection Settings (Phase 5 - ML)
# -----------------------------------------------------------------------------
DETECTION_THRESHOLD=0.7
